#!/bin/bash
set -e

# ---------------------------
# Docker Entrypoint for Rails
# ---------------------------

# Ensure RAILS_MASTER_KEY is set
if [ -z "$RAILS_MASTER_KEY" ]; then
  echo "ERROR: RAILS_MASTER_KEY environment variable is not set!"
  exit 1
fi

export RAILS_MASTER_KEY

# Ensure tmp directories exist
mkdir -p tmp/pids tmp/cache tmp/sockets log

# Check if database exists, then prepare (create, migrate, seed)
echo "==> Preparing database..."
bundle exec rails db:prepare

# Precompile assets if missing
if [ ! -d "public/assets" ]; then
  echo "==> Precompiling assets..."
  bundle exec rails assets:precompile
fi

# Start Rails server
echo "==> Starting Rails server..."
exec "$@"
