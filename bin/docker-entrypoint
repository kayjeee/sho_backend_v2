#!/bin/bash
set -e

# -----------------------------
# Docker Entrypoint for Rails
# -----------------------------
# Usage: docker run ... sho_backend [rails server options]

echo "Starting Docker Entrypoint..."
echo "RAILS_ENV=${RAILS_ENV:-development}"

# Ensure Bundler bin is in PATH
export PATH="/usr/local/bundle/bin:$PATH"

# Optional: wait for database to be ready (Postgres example)
if [ -n "$WAIT_FOR_DB" ]; then
  echo "Waiting for database..."
  until bundle exec rails db:version >/dev/null 2>&1; do
    echo "Database not ready, sleeping 2s..."
    sleep 2
  done
fi

# Run pending migrations in production automatically
if [ "$RAILS_ENV" = "production" ]; then
  echo "Running migrations..."
  bundle exec rails db:migrate
fi

# Execute the CMD passed in Dockerfile (or docker-compose)
exec "$@"
